# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"

# For local development use localhost:3000
# For production (Render), change this to your actual deployed URL e.g:
# NEXTAUTH_URL="https://your-app-name.onrender.com"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend) — get your free API key at https://resend.com
# Without this, email notifications will NOT work
RESEND_API_KEY="re_your_api_key_here"
MAIL_FROM="Society Admin <onboarding@resend.dev>" #use ur mail here
